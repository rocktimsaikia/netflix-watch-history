{
  "manifest_version": 3,
  "name": "Watch History for Netflix",
  "version": "1.2.0",
  "description": "Adds the missing History button to Netflix and Prime Video navbars.",
  "browser_specific_settings": {
    "gecko": {
      "id": "watch-history-for-netflix@rocktimsaikia.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
